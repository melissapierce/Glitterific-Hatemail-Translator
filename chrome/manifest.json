{
  "manifest_version": 3,
  "name": "Glitterific Hate Mail Translator",
  "short_name": "Glitterific",
  "version": "2.0.2",
  "description": "Turn hate mail into fan mail with one click. Swaps hostile words for sparkly ones in Gmail and Outlook, all inside your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Glitterific",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ],
      "js": [
        "wordlist.js",
        "content.js"
      ],
      "css": [
        "glitter.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
